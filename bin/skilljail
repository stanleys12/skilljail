#!/bin/sh
# Runs the CLI from this checkout, so the Claude Code plugin works without a pip install (needs python3 >= 3.11 with pyyaml).
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if ! command -v python3 >/dev/null 2>&1; then
    echo "skilljail: python3 (>= 3.11) is required but was not found on PATH" >&2
    exit 127
fi
PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m skilljail.cli "$@"
